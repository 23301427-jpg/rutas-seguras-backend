# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (SQLite - se crea automáticamente como archivo local)
DB_STORAGE=./database.sqlite

# JWT
JWT_SECRET=cambia_este_secreto_por_uno_seguro
JWT_EXPIRES_IN=7d

# Twilio (SMS). Si dejas estos campos vacíos, el sistema
# simulará el envío de SMS y lo mostrará en consola (modo desarrollo).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Umbral de inactividad para detección automática (minutos)
INACTIVITY_THRESHOLD_MINUTES=15

# URL base del frontend (para generar enlaces de monitoreo en vivo)
FRONTEND_BASE_URL=http://localhost:5173
